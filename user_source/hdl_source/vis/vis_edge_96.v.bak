`timescale 1ns / 1ps
//----------------------------------------------------------------------------
// vis_edge_96
//
// Scharr edge detector on the 96-bit ISP stream (4 x RGB888 per beat).
// Two gradient samples are produced per beat, giving 640 horizontal edge
// samples per line, and each result is duplicated back to its pair of pixels.
//
// Operator: Scharr, 3 10 3 / 0 0 0 / -3 -10 -3. Different from the reference
// design's Sobel (1 2 1), and only shifts and adds are used.
//
// The whole chain - gray, pair average, line buffer read, gradient, compare -
// does not fit one 9.66 ns ISP clock, so it is cut into three registered
// stages. Stream control is delayed by the same count so tuser/tlast stay
// aligned with the pixels.
//----------------------------------------------------------------------------
module vis_edge_96 #(
    parameter IMG_WIDTH  = 1280,
    parameter IMG_HEIGHT = 720
)(
    input               I_clk,
    input               I_rst_n,
    input               I_tlast,
    input               I_tuser,
    input      [95:0]   I_tdata,
    input               I_tvalid,
    input               I_tready,
    // Adaptive threshold from the Otsu engine. Feeding it a value computed from
    // the current frame's histogram is what makes this edge detector track
    // strong or dim lighting instead of failing on a fixed constant.
    input      [14:0]   I_edge_th,
    output reg          O_tlast,
    output reg          O_tuser,
    output reg [95:0]   O_tdata,
    output reg          O_tvalid,
    output              O_tready
);

assign O_tready = I_tready;

wire [23:0] pix0 = I_tdata[95:72];
wire [23:0] pix1 = I_tdata[71:48];
wire [23:0] pix2 = I_tdata[47:24];
wire [23:0] pix3 = I_tdata[23:0];

// Low-cost luminance approximation: R/4 + G/2 + B/4. Maximum is 253, so it
// always fits an 8-bit result and needs no divider.
wire [7:0] gray0 = {2'b0,pix0[23:18]} + {1'b0,pix0[15:9]} + {2'b0,pix0[7:2]};
wire [7:0] gray1 = {2'b0,pix1[23:18]} + {1'b0,pix1[15:9]} + {2'b0,pix1[7:2]};
wire [7:0] gray2 = {2'b0,pix2[23:18]} + {1'b0,pix2[15:9]} + {2'b0,pix2[7:2]};
wire [7:0] gray3 = {2'b0,pix3[23:18]} + {1'b0,pix3[15:9]} + {2'b0,pix3[7:2]};

localparam IMG_WIDTH_GRP = (IMG_WIDTH >> 2);

//--------------------------------------------------------------------------
// Stage 1: register the grays and the stream control.
//--------------------------------------------------------------------------
reg [7:0] g0_r, g1_r, g2_r, g3_r;
reg       v1, u1, l1;

always @(posedge I_clk or negedge I_rst_n) begin
    if(!I_rst_n) begin
        g0_r <= 8'd0; g1_r <= 8'd0; g2_r <= 8'd0; g3_r <= 8'd0;
        v1 <= 1'b0; u1 <= 1'b0; l1 <= 1'b0;
    end else begin
        g0_r <= gray0; g1_r <= gray1; g2_r <= gray2; g3_r <= gray3;
        v1 <= I_tvalid; u1 <= I_tuser; l1 <= I_tlast;
    end
end

// Two grayscale samples per input beat. Each sample averages a neighbouring
// pair of pixels, which also suppresses sensor noise before the gradient.
wire [8:0] pair_sum0 = {1'b0,g0_r} + {1'b0,g1_r};
wire [8:0] pair_sum1 = {1'b0,g2_r} + {1'b0,g3_r};
wire [7:0] pair0 = pair_sum0[8:1];
wire [7:0] pair1 = pair_sum1[8:1];

(* ram_style = "block" *) reg [15:0] line1_mem [0:IMG_WIDTH_GRP-1];
(* ram_style = "block" *) reg [15:0] line2_mem [0:IMG_WIDTH_GRP-1];

reg [10:0] x_grp;
reg [10:0] y_pos;

wire [15:0] top_word = line2_mem[x_grp];
wire [15:0] mid_word = line1_mem[x_grp];
wire [15:0] bot_word = {pair0,pair1};

wire [7:0] top0 = top_word[15:8];
wire [7:0] top1 = top_word[7:0];
wire [7:0] mid0 = mid_word[15:8];
wire [7:0] mid1 = mid_word[7:0];

reg [7:0] top_prev2, top_prev1;
reg [7:0] mid_prev2, mid_prev1;
reg [7:0] bot_prev2, bot_prev1;

//--------------------------------------------------------------------------
// Scharr magnitude. 3*x == (x<<1)+x ; 10*x == (x<<3)+(x<<1).
//--------------------------------------------------------------------------
function [14:0] scharr_mag;
    input [7:0] a00, a01, a02;
    input [7:0] a10, a11, a12;
    input [7:0] a20, a21, a22;
    reg signed [13:0] gx_f;
    reg signed [13:0] gy_f;
    reg [13:0] abs_gx_f;
    reg [13:0] abs_gy_f;
    begin
        gx_f = -(($signed({1'b0,a00}) <<< 1) + $signed({1'b0,a00}))
             + (($signed({1'b0,a02}) <<< 1) + $signed({1'b0,a02}))
             - (($signed({1'b0,a10}) <<< 3) + ($signed({1'b0,a10}) <<< 1))
             + (($signed({1'b0,a12}) <<< 3) + ($signed({1'b0,a12}) <<< 1))
             - (($signed({1'b0,a20}) <<< 1) + $signed({1'b0,a20}))
             + (($signed({1'b0,a22}) <<< 1) + $signed({1'b0,a22}));
        gy_f =  (($signed({1'b0,a00}) <<< 1) + $signed({1'b0,a00}))
             + (($signed({1'b0,a01}) <<< 3) + ($signed({1'b0,a01}) <<< 1))
             + (($signed({1'b0,a02}) <<< 1) + $signed({1'b0,a02}))
             - (($signed({1'b0,a20}) <<< 1) + $signed({1'b0,a20}))
             - (($signed({1'b0,a21}) <<< 3) + ($signed({1'b0,a21}) <<< 1))
             - (($signed({1'b0,a22}) <<< 1) + $signed({1'b0,a22}));
        abs_gx_f = gx_f[13] ? (~gx_f + 1'b1) : gx_f;
        abs_gy_f = gy_f[13] ? (~gy_f + 1'b1) : gy_f;
        scharr_mag = abs_gx_f + abs_gy_f;
    end
endfunction

wire [14:0] mag0 = scharr_mag(top_prev2,top_prev1,top0,
                              mid_prev2,mid_prev1,mid0,
                              bot_prev2,bot_prev1,pair0);
wire [14:0] mag1 = scharr_mag(top_prev1,top0,top1,
                              mid_prev1,mid0,mid1,
                              bot_prev1,pair0,pair1);

// The first two rows and the first column have no full 3x3 window.
wire window_valid = (y_pos >= 11'd2) && (x_grp != 11'd0) && !u1;

//--------------------------------------------------------------------------
// Stage 2: register the magnitudes and carry the control one stage further.
//--------------------------------------------------------------------------
reg [14:0] mag0_r, mag1_r;
reg        wv2, v2, u2, l2;

    wire edge0 = wv2 && (mag0_r >= I_edge_th);
    wire edge1 = wv2 && (mag1_r >= I_edge_th);

wire [23:0] out0 = edge0 ? 24'hffffff : 24'h000000;
wire [23:0] out1 = edge1 ? 24'hffffff : 24'h000000;

//--------------------------------------------------------------------------
// Stage 3: output register, line buffers and the window position.
//--------------------------------------------------------------------------
always @(posedge I_clk or negedge I_rst_n) begin
    if(!I_rst_n) begin
        O_tlast  <= 1'b0;
        O_tuser  <= 1'b0;
        O_tdata  <= 96'd0;
        O_tvalid <= 1'b0;
        x_grp    <= 11'd0;
        y_pos    <= 11'd0;
        top_prev2 <= 8'd0; top_prev1 <= 8'd0;
        mid_prev2 <= 8'd0; mid_prev1 <= 8'd0;
        bot_prev2 <= 8'd0; bot_prev1 <= 8'd0;
        mag0_r <= 15'd0; mag1_r <= 15'd0;
        wv2 <= 1'b0; v2 <= 1'b0; u2 <= 1'b0; l2 <= 1'b0;
        // Line memories are deliberately not reset: a reset loop turns these
        // 10-Kbit buffers into slice registers on this device. The first two
        // rows are masked by window_valid and fill the buffers naturally.
    end else begin
        // ---- stage 2 ------------------------------------------------------
        mag0_r <= mag0;
        mag1_r <= mag1;
        wv2    <= window_valid;
        v2 <= v1; u2 <= u1; l2 <= l1;

        // ---- stage 3: output ---------------------------------------------
        O_tlast  <= l2;
        O_tuser  <= u2;
        O_tvalid <= v2;
        if(v2)
            O_tdata <= {out0,out0,out1,out1};
        else
            O_tdata <= 96'd0;

        // ---- line buffers and window position, on the stage-1 control ----
        if(v1) begin
            line2_mem[x_grp] <= mid_word;
            line1_mem[x_grp] <= bot_word;

            top_prev2 <= top0; top_prev1 <= top1;
            mid_prev2 <= mid0; mid_prev1 <= mid1;
            bot_prev2 <= pair0; bot_prev1 <= pair1;

            if(u1) begin
                x_grp <= 11'd1;
                y_pos <= 11'd0;
            end else if(x_grp == IMG_WIDTH_GRP - 1) begin
                x_grp <= 11'd0;
                if(y_pos == IMG_HEIGHT - 1)
                    y_pos <= 11'd0;
                else
                    y_pos <= y_pos + 1'b1;
                top_prev2 <= 8'd0; top_prev1 <= 8'd0;
                mid_prev2 <= 8'd0; mid_prev1 <= 8'd0;
                bot_prev2 <= 8'd0; bot_prev1 <= 8'd0;
            end else begin
                x_grp <= x_grp + 1'b1;
            end
        end
    end
end

endmodule
